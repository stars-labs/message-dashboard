// The Svelte 5 SPA. DOM only: nothing in client/ runs under Node. Client files
// join this project one by one as each is made clean; eslint.config.ts reads
// this include list, so it is the one record of what has joined.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/client.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "svelte"],
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/client-declarations"
  },
  "include": [
    "client/lib/card-number.ts",
    "client/lib/modem-position.ts",
    "client/lib/sim-role.ts"
  ],
  "references": [{ "path": "./tsconfig.shared.json" }]
}
