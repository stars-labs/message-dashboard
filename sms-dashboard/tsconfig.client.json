// The Svelte 5 SPA. DOM only: nothing in client/ runs under Node. Client files
// join this project one by one as each is made clean; eslint.config.ts reads
// this include list, so it is the one record of what has joined.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/client.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "svelte"],
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/client-declarations"
  },
  "include": [
    "client/lib/api.ts",
    "client/lib/auth.ts",
    "client/lib/balance-polling.ts",
    "client/lib/call-client.ts",
    "client/lib/call-ringtone.ts",
    "client/lib/call-session.ts",
    "client/lib/card-number.ts",
    "client/lib/carrier.ts",
    "client/lib/clipboard.ts",
    "client/lib/confirm.svelte.ts",
    "client/lib/countries.ts",
    "client/lib/daemon-status.ts",
    "client/lib/device-status.ts",
    "client/lib/error-origin.ts",
    "client/lib/group-by-primary.ts",
    "client/lib/message-cache.ts",
    "client/lib/message-highlight.ts",
    "client/lib/message-page.ts",
    "client/lib/message-status.ts",
    "client/lib/mobile-tab-state.ts",
    "client/lib/modem-position.ts",
    "client/lib/overlay.ts",
    "client/lib/pull-to-refresh.ts",
    "client/lib/sim-role.ts",
    "client/lib/sim-service-type.ts",
    "client/lib/sw-reset.ts",
    "client/lib/sw-update.ts",
    "client/lib/swipe-dismiss.ts",
    "client/lib/tag-store.ts",
    "client/lib/time.ts",
    "client/vite-env.d.ts"
  ],
  "references": [{ "path": "./tsconfig.shared.json" }]
}
