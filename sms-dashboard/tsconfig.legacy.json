// Everything that has not joined the strict gate yet: the pre-migration
// tsconfig, renamed. Its options and include list are exactly what the repo
// shipped with, so each area stays checked at the level it was checked at
// before, and no area is ever unchecked.
//
// Each phase moves its area into a strict project and deletes it from the
// include list here. The commit that empties the list deletes this file.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,

    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "types": []
  },
  "include": ["server/**/*.ts", "client/**/*.ts"],
  "exclude": ["node_modules", "dist", "balance-agent/dist", "balance-agent/release"]
}
