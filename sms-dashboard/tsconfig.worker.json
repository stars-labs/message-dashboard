// The Cloudflare Worker. Server files join this project one by one as each is
// made clean; eslint.config.ts reads this include list, so it is the one record
// of what has joined. worker-runtime.d.ts holds the runtime globals.
// worker-configuration.d.ts (the Env bindings) joins with the last file: it
// types the Durable Object binding through server/index.ts, which imports
// every route.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/worker.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/worker-declarations"
  },
  "include": [
    "worker-runtime.d.ts",
    "server/lib/**/*.ts",
    "server/handlers/phones.ts",
    "server/asset-cache-control.ts",
    "server/utils/keyword-match.ts",
    "server/utils/keyword-color.ts",
    "server/utils/recipient.ts",
    "server/utils/session-token.ts",
    "server/utils/d1-error.ts",
    "server/middleware/cors.ts",
    "server/utils/user-sessions.ts",
    "server/utils/singtel-postpaid-bill.ts",
    "server/utils/m1-web-balance.ts",
    "server/utils/unicom-web-balance.ts",
    "server/utils/daemon-health.ts",
    "server/utils/verification.ts",
    "server/utils/company-ai.ts",
    "server/utils/message-retention.ts",
    "server/middleware/rbac.ts",
    "server/api/call-state.ts",
    "server/utils/audit-log.ts"
  ],
  "exclude": ["**/*.test.ts"],
  "references": [{ "path": "./tsconfig.shared.json" }]
}
