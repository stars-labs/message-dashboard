{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,

    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "shared/**/*.ts",
    "config/**/*.ts",
    "server/index.ts",
    "server/middleware/**/*.ts",
    "client/lib/**/*.ts",
    "client/*.ts"
  ],
  "exclude": ["node_modules", "dist", "balance-agent/dist", "balance-agent/release"]
}