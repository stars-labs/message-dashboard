// Runner core, shared by the Balance Agent (Electron main process and Bun CLI).
// It runs under Node or Bun, never in the Worker or the browser, and drives the
// carrier portal through an injected Playwright-compatible launcher.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/runner-core.tsbuildinfo",
    "types": ["bun"],
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/runner-core-declarations"
  },
  "include": ["runner-core/**/*.ts"],
  "exclude": ["**/*.test.ts"],
  "references": [{ "path": "./tsconfig.shared.json" }, { "path": "./tsconfig.worker.json" }]
}
