// The build script, which runs under Bun.
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tooling.tsbuildinfo",
    "types": ["bun"],
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/tooling-declarations"
  },
  "include": ["scripts/**/*.ts"]
}
