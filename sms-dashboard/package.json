{
  "name": "sms-dashboard",
  "workspaces": [
    "balance-agent"
  ],
  "version": "1.0.0",
  "description": "SMS Dashboard with Cloudflare Workers",
  "type": "module",
  "scripts": {
    "test": "bun run test:runtime && bun run test:client",
    "test:runtime": "bun test --path-ignore-patterns='client/**' --path-ignore-patterns='balance-agent/**'",
    "test:client": "bun --config=bunfig.client.toml test --conditions=browser ./client/",
    "lint": "bun run --bun eslint . --max-warnings 0",
    "typecheck": "tsc -b && bun run --cwd balance-agent typecheck && bun run typecheck:svelte",
    "typecheck:svelte": "svelte-check --tsconfig ./tsconfig.client.json --fail-on-warnings && svelte-check --tsconfig ./tsconfig.client-test.json --fail-on-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --no-progress",
    "check:no-js": "bun scripts/check-no-js.ts",
    "check": "bun run check:no-js && bun run format:check && bun run typecheck && bun run lint && bun run knip && bun run check:worker-types && bun run test && bun run build && bun run --cwd balance-agent check",
    "check:worker-types": "bunx wrangler types --strict-vars=false --include-runtime=false && bunx wrangler types worker-runtime.d.ts --include-env=false && git -C .. diff --exit-code -- sms-dashboard/worker-configuration.d.ts sms-dashboard/worker-runtime.d.ts",
    "dev": "bunx vite",
    "dev:api": "bunx wrangler dev",
    "build": "bunx vite build",
    "build:unified": "bun run build && bun scripts/build-unified.ts",
    "deploy": "bun run build:unified && bunx wrangler deploy",
    "preview": "bunx vite preview",
    "db:init": "bunx wrangler d1 execute sms-dashboard --local --file=./migrations/schema.sql",
    "db:migrate": "bunx wrangler d1 execute sms-dashboard --file=./migrations/schema.sql"
  },
  "dependencies": {
    "jose": "^6.0.11",
    "nanoid": "^5.1.5",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/config-helpers": "^0.7.0",
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.11.2",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/svelte": "^5.4.2",
    "@types/bun": "^1.4.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.1",
    "fake-indexeddb": "6.2.8",
    "knip": "5.88.1",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.2.1",
    "postcss-value-parser": "^4.2.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "^5.35.5",
    "svelte-check": "4.7.8",
    "tailwindcss": "^3.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.119.0"
  }
}
