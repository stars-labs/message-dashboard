{
  "name": "sms-dashboard",
  "version": "2.0.0",
  "description": "SMS Dashboard with ElysiaJS - Cloudflare Workers & VPS Compatible",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bunx vite",
    "dev:api": "bun run --watch src/index.ts",
    "dev:cf": "bunx wrangler dev",
    "build": "bunx vite build",
    "build:api": "bun build src/index.ts --target=node --outdir=dist",
    "deploy:cf": "bunx wrangler deploy",
    "preview": "bunx vite preview",
    "db:init": "bun run scripts/init-db.ts",
    "db:push": "bunx drizzle-kit push",
    "db:generate": "bunx drizzle-kit generate",
    "db:studio": "bunx drizzle-kit studio",
    "clean": "rm -rf dist node_modules bun.lockb data/*.db backup-legacy"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.2",
    "drizzle-orm": "^0.38.2",
    "elysia": "^1.1.29",
    "jose": "^6.0.11",
    "nanoid": "^5.1.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "svelte": "^5.35.5",
    "tailwindcss": "^3.4.0",
    "vite": "^7.0.3",
    "wrangler": "^4.24.0",
    "drizzle-kit": "^0.30.1",
    "@types/node": "^22.0.0"
  }
}
