{
  "name": "sms-dashboard",
  "version": "1.0.0",
  "description": "SMS Dashboard with Cloudflare Workers",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "bun test --conditions=browser",
    "lint": "bun run lint:strict && bun run lint:legacy",
    "lint:strict": "bun run --bun eslint . --max-warnings 0",
    "lint:legacy": "oxlint",
    "typecheck": "tsc -b && tsc -p tsconfig.legacy.json",
    "check": "bun run typecheck && bun run lint && bun run check:worker-types && bun run test && bun run build",
    "check:worker-types": "bunx wrangler types && git -C .. diff --exit-code -- sms-dashboard/worker-configuration.d.ts",
    "dev": "bunx vite",
    "dev:api": "bunx wrangler dev",
    "build": "bunx vite build",
    "build:unified": "bun run build && bun scripts/build-unified.js",
    "deploy": "bun run build:unified && bunx wrangler deploy",
    "preview": "bunx vite preview",
    "db:init": "bunx wrangler d1 execute sms-dashboard --local --file=./migrations/schema.sql",
    "db:migrate": "bunx wrangler d1 execute sms-dashboard --file=./migrations/schema.sql"
  },
  "dependencies": {
    "jose": "^6.0.11",
    "nanoid": "^5.1.5"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/config-helpers": "^0.7.0",
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.11.2",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/svelte": "^5.4.2",
    "@types/bun": "^1.4.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.93.0",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.6",
    "svelte": "^5.35.5",
    "tailwindcss": "^3.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.119.0"
  }
}
