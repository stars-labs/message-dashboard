{
  "info": {
    "title": "SMS Dashboard API",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "auth_token",
        "description": "The dashboard session, set by the Auth0 login callback."
      },
      "auth0": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "daemonKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "responses": {
      "Problem": {
        "description": "An RFC 9457 problem.",
        "content": {
          "application/problem+json": {
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "status": {
                  "type": "integer"
                },
                "detail": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "title",
                "status",
                "detail",
                "code"
              ]
            }
          }
        }
      },
      "DaemonError": {
        "description": "The error the Pi daemon reads; shared/control-fixtures/ records each.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "const": false
                },
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          }
        }
      }
    }
  },
  "openapi": "3.1.1",
  "paths": {
    "/api/control/heartbeat": {
      "post": {
        "operationId": "control.heartbeat",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "message": {
                      "type": "string"
                    },
                    "received_at": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "message",
                    "received_at"
                  ],
                  "$schema": "https://json-schema.org/draft/2020-12/schema"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/DaemonError"
          }
        },
        "security": [
          {
            "daemonKey": []
          }
        ]
      }
    },
    "/api/users": {
      "get": {
        "operationId": "users.list",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "users": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "email": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "name": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "last_login": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "logins_count": {
                            "type": "number"
                          },
                          "roles": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "role": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "email",
                          "name",
                          "last_login",
                          "logins_count",
                          "roles",
                          "role"
                        ]
                      }
                    },
                    "known_roles": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "admin_role": {
                      "type": "string"
                    },
                    "viewer_role": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "users",
                    "known_roles",
                    "admin_role",
                    "viewer_role"
                  ],
                  "$schema": "https://json-schema.org/draft/2020-12/schema"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "security": [
          {
            "session": [
              "users.read"
            ]
          },
          {
            "auth0": [
              "users.read"
            ]
          }
        ]
      }
    },
    "/api/users/{id}/role": {
      "put": {
        "operationId": "users.setRole",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string"
                  }
                },
                "required": [
                  "role"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "user_id": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    },
                    "previous_roles": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "sessions_revoked": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "success",
                    "user_id",
                    "role",
                    "previous_roles",
                    "sessions_revoked"
                  ],
                  "$schema": "https://json-schema.org/draft/2020-12/schema"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "security": [
          {
            "session": [
              "users.write"
            ]
          },
          {
            "auth0": [
              "users.write"
            ]
          }
        ]
      }
    }
  }
}
