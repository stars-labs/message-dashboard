{
  "info": {
    "title": "SMS Dashboard API",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "auth_token",
        "description": "The dashboard session, set by the Auth0 login callback."
      },
      "auth0": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "daemonKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "responses": {
      "Problem": {
        "description": "An RFC 9457 problem.",
        "content": {
          "application/problem+json": {
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "status": {
                  "type": "integer"
                },
                "detail": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "title",
                "status",
                "detail",
                "code"
              ]
            }
          }
        }
      },
      "DaemonError": {
        "description": "The error the Pi daemon reads; shared/control-fixtures/ records each.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "const": false
                },
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          }
        }
      }
    }
  },
  "openapi": "3.1.1",
  "paths": {
    "/api/control/heartbeat": {
      "post": {
        "operationId": "control.heartbeat",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "message": {
                      "type": "string"
                    },
                    "received_at": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "message",
                    "received_at"
                  ],
                  "$schema": "https://json-schema.org/draft/2020-12/schema"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/DaemonError"
          }
        },
        "security": [
          {
            "daemonKey": []
          }
        ]
      }
    },
    "/api/live": {
      "get": {
        "operationId": "health.live",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "alive"
                    },
                    "timestamp": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "timestamp"
                  ],
                  "$schema": "https://json-schema.org/draft/2020-12/schema"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "security": []
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health.ready",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "healthy"
                    },
                    "database": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": "connected"
                        }
                      },
                      "required": [
                        "status"
                      ]
                    },
                    "daemon": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": "healthy"
                        },
                        "label": {
                          "type": "string"
                        },
                        "reasons": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "last_heartbeat": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "label",
                        "reasons",
                        "last_heartbeat"
                      ]
                    },
                    "timestamp": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "database",
                    "daemon",
                    "timestamp"
                  ],
                  "$schema": "https://json-schema.org/draft/2020-12/schema"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "security": []
      }
    },
    "/api/daemon/status": {
      "get": {
        "operationId": "health.daemonStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "enum": [
                            "unknown",
                            "offline",
                            "degraded",
                            "healthy"
                          ],
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "reasons": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "snapshot": {
                          "type": "null"
                        },
                        "timestamp": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "status",
                        "label",
                        "reasons",
                        "snapshot",
                        "timestamp"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "daemon_id": {
                          "type": "string"
                        },
                        "status": {
                          "enum": [
                            "unknown",
                            "offline",
                            "degraded",
                            "healthy"
                          ],
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "last_heartbeat": {
                          "type": "string"
                        },
                        "seconds_since_heartbeat": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "message": {
                          "type": "string"
                        },
                        "reasons": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "snapshot": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "schema_version": {
                                  "const": 3
                                },
                                "session_id": {
                                  "type": "string"
                                },
                                "version": {
                                  "type": "string"
                                },
                                "uptime_seconds": {
                                  "type": "number"
                                },
                                "last_message_read_success_age_seconds": {
                                  "anyOf": [
                                    {
                                      "type": "number"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "last_upload_success_age_seconds": {
                                  "anyOf": [
                                    {
                                      "type": "number"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "queue": {
                                  "type": "object",
                                  "properties": {
                                    "pending": {
                                      "type": "number"
                                    },
                                    "in_flight": {
                                      "type": "number"
                                    },
                                    "dead_letter": {
                                      "type": "number"
                                    },
                                    "oldest_unacknowledged_age_seconds": {
                                      "anyOf": [
                                        {
                                          "type": "number"
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    }
                                  },
                                  "required": [
                                    "pending",
                                    "in_flight",
                                    "dead_letter",
                                    "oldest_unacknowledged_age_seconds"
                                  ]
                                }
                              },
                              "required": [
                                "schema_version",
                                "session_id",
                                "version",
                                "uptime_seconds",
                                "last_message_read_success_age_seconds",
                                "last_upload_success_age_seconds",
                                "queue"
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "timestamp": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "daemon_id",
                        "status",
                        "label",
                        "last_heartbeat",
                        "seconds_since_heartbeat",
                        "message",
                        "reasons",
                        "snapshot",
                        "timestamp"
                      ]
                    }
                  ],
                  "$schema": "https://json-schema.org/draft/2020-12/schema"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "security": [
          {
            "session": [
              "messages.read"
            ]
          },
          {
            "auth0": [
              "messages.read"
            ]
          }
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "auth.me",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "sub": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "picture": {
                          "type": "string"
                        },
                        "provider": {
                          "type": "string"
                        },
                        "roles": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "permissions": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "id",
                        "roles",
                        "permissions"
                      ]
                    }
                  },
                  "required": [
                    "success",
                    "user"
                  ],
                  "$schema": "https://json-schema.org/draft/2020-12/schema"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "auth0": []
          }
        ]
      }
    },
    "/api/users": {
      "get": {
        "operationId": "users.list",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "users": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "email": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "name": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "last_login": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "logins_count": {
                            "type": "number"
                          },
                          "roles": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "role": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "email",
                          "name",
                          "last_login",
                          "logins_count",
                          "roles",
                          "role"
                        ]
                      }
                    },
                    "known_roles": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "admin_role": {
                      "type": "string"
                    },
                    "viewer_role": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "users",
                    "known_roles",
                    "admin_role",
                    "viewer_role"
                  ],
                  "$schema": "https://json-schema.org/draft/2020-12/schema"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "security": [
          {
            "session": [
              "users.read"
            ]
          },
          {
            "auth0": [
              "users.read"
            ]
          }
        ]
      }
    },
    "/api/users/{id}/role": {
      "put": {
        "operationId": "users.setRole",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string"
                  }
                },
                "required": [
                  "role"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "user_id": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    },
                    "previous_roles": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "sessions_revoked": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "success",
                    "user_id",
                    "role",
                    "previous_roles",
                    "sessions_revoked"
                  ],
                  "$schema": "https://json-schema.org/draft/2020-12/schema"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "security": [
          {
            "session": [
              "users.write"
            ]
          },
          {
            "auth0": [
              "users.write"
            ]
          }
        ]
      }
    }
  }
}
