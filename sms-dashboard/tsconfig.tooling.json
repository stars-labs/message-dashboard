// Build and lint tooling: ESLint's own config runs under Bun, not in the Worker
// or the browser.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tooling.tsbuildinfo",
    "types": ["bun"],
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/tooling-declarations"
  },
  "include": [
    "eslint.config.ts",
    "vite.config.ts",
    "tailwind.config.ts",
    "postcss.config.ts",
    "tailwindcss-forms.d.ts",
    "scripts/**/*.ts"
  ],
  "references": [{ "path": "./tsconfig.shared.json" }]
}
