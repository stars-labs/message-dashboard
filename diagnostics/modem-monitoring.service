# Systemd service for automatic modem monitoring
# Place in /etc/systemd/system/modem-monitoring.service

[Unit]
Description=USB Modem Array Health Monitoring
After=ModemManager.service
Wants=ModemManager.service

[Service]
Type=oneshot
ExecStart=/home/freeman.xiong/Documents/github/hecoinfo/message-dashboard/diagnostics/comprehensive_modem_monitor.sh
User=root
Group=root
StandardOutput=journal
StandardError=journal

# Resource limits
MemoryLimit=100M
CPUQuota=10%

[Install]
WantedBy=multi-user.target