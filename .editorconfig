# Editor defaults for the whole repository. Formatting is not enforced by a
# tool here (Rust uses rustfmt, the web side has no formatter); this only stops
# editors from introducing tabs or CRLF into files the repo keeps as spaces/LF.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.nix]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false